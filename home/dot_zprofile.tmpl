{{- /*
  Generated from .chezmoidata/packages.yaml.
  Scaffolding (XDG, EDITOR, brew shellenv) is fixed; per-package zprofile
  init blocks are appended in .zprofile.order order.
*/ -}}

{{- $packages := (includeTemplate "packages.tmpl" .) | fromYaml -}}
{{- $active   := $packages.packages -}}

# Set up XDG
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
{{ if eq .chezmoi.os "darwin" -}}
export XDG_RUNTIME_DIR="$(getconf DARWIN_USER_TEMP_DIR)"
{{- else -}}
export XDG_RUNTIME_DIR="/run/user/$UID"
{{- end }}
export XDG_STATE_HOME="$HOME/.local/state"

{{ if findExecutable "brew" (list "/opt/homebrew/bin" "/home/linuxbrew/.linuxbrew/bin") -}}
# Set up Homebrew
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
eval "$({{ findExecutable "brew" (list "/opt/homebrew/bin" "/home/linuxbrew/.linuxbrew/bin") }} shellenv)"
{{- end }}

{{- /* Per-package zprofile init, sorted by zprofile.order via map-key trick */ -}}
{{- $inits := dict -}}
{{- range $active -}}
  {{- $name := .name -}}
  {{- with (index . "zprofile") -}}
    {{- $order := default 50 (index . "order") | int -}}
    {{- $key := printf "%04d_%s" $order $name -}}
    {{- $inits = set $inits $key (dict "name" $name "order" $order "content" .content) -}}
  {{- end -}}
{{- end }}
{{ range $k, $v := $inits }}
# package={{ $v.name }}, order={{ $v.order }}
{{ trimSuffix "\n" $v.content }}
{{ end -}}
