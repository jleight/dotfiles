{{- /*
  Generated from .chezmoitemplates/packages.d/.
  Emits OMZ plugin list and per-package zshrc init blocks (sorted by
  zshrc.order, default 50). Aliases are authored as inline `alias x="y"`
  lines inside zshrc.content.
*/ -}}

{{- $packages := (includeTemplate "packages.tmpl" .) | fromYaml -}}
{{- $active   := $packages.packages -}}

# Per-section startup profiler — logs to ~/.zsh_startup.log.
# Disable by setting ZSH_STARTUP_PROFILE=0 (or remove this block once tuned).
: ${ZSH_STARTUP_PROFILE:=1}
if (( ZSH_STARTUP_PROFILE )); then
	zmodload zsh/datetime
	_zsp_start=$EPOCHREALTIME
	_zsp_prev=$_zsp_start
	_zsp_log=~/.zsh_startup.log
	_zsp_mark() {
		local now=$EPOCHREALTIME
		printf '%s  %5dms  %s\n' "$(date '+%F %T')" \
			$(( (now - _zsp_prev) * 1000 )) "$1" >> $_zsp_log
		_zsp_prev=$now
	}
	_zsp_done() {
		local now=$EPOCHREALTIME
		printf '%s  %5dms  TOTAL\n\n' "$(date '+%F %T')" \
			$(( (now - _zsp_start) * 1000 )) >> $_zsp_log
	}
else
	_zsp_mark() { :; }
	_zsp_done() { :; }
fi

# Disable OMZ updates
zstyle ':omz:update' mode disabled

# Skip OMZ's compaudit security check (slow)
ZSH_DISABLE_COMPFIX=true

# Enable OMZ plugins
plugins=(
{{- range $active }}{{ with (index . "omz") }}{{ range (default list (index . "plugins")) }}
	{{ . }}
{{- end }}{{ end }}{{ end }}
)

# Set OMZ theme
ZSH_THEME="gentoo"
_zsp_mark "OMZ config"

# Include OMZ
export ZSH="${HOME}/.oh-my-zsh"
source "${ZSH}/oh-my-zsh.sh"
_zsp_mark "OMZ source"
{{/* Per-package zshrc init, sorted by zshrc.order via map-key trick */ -}}
{{- $inits := dict -}}
{{- range $active -}}
  {{- $name := .name -}}
  {{- with (index . "zshrc") -}}
    {{- $order := default 50 (index . "order") | int -}}
    {{- $key := printf "%04d_%s" $order $name -}}
    {{- $inits = set $inits $key (dict "name" $name "order" $order "content" .content) -}}
  {{- end -}}
{{- end -}}
{{- range $k, $v := $inits }}
# package={{ $v.name }}, order={{ $v.order }}
{{ trimSuffix "\n" $v.content }}
_zsp_mark {{ $v.name | quote }}
{{ end }}
_zsp_done
