{{- /*
  Generated from .chezmoitemplates/packages.d/.
  Emits mise [tools], [env], and [shell_alias] from packages enabled by the
  active profile. Version semantics:
    - no install.version / install.versions  → "latest"
    - install.version: X                     → "X"
    - install.versions: [X, Y, Z]            → ["X", "Y", "Z"]
*/ -}}
{{- $profile  := .profile -}}
{{- $packages := (includeTemplate "packages.tmpl" .) | fromYaml -}}
{{- $active   := $packages.packages -}}

[settings]
experimental = true

[tools]
{{- range $active -}}
  {{- $install := default dict (index . "install") -}}
  {{- $via     := default dict (index $install "via") -}}
  {{- if hasKey $via "mise" -}}
    {{- $tool := index $via "mise" }}
{{ $tool | quote }} = {{ if hasKey $install "versions" -}}
[{{ range $i, $v := index $install "versions" }}{{ if $i }}, {{ end }}{{ printf "%v" $v | quote }}{{ end }}]
    {{- else if hasKey $install "version" -}}
{{ printf "%v" (index $install "version") | quote }}
    {{- else -}}
"latest"
    {{- end -}}
  {{- end -}}
{{- end }}

[env]
{{- range $active }}
  {{- range (default list (index (default dict (index . "mise")) "env")) }}
    {{- if hasKey . "secret" }}
{{ .name }} = {{ onepasswordRead (printf "op://%s/%s" $profile.op.vault (index . "secret")) $profile.op.account | quote }}
    {{- else if hasKey . "value" }}
{{ .name }} = {{ printf "%v" (index . "value") | quote }}
    {{- end }}
  {{- end }}
{{- end }}

[shell_alias]
{{- range $active }}
  {{- range $k, $v := (default dict (index (default dict (index . "mise")) "shell_alias")) }}
{{ $k }} = {{ $v | quote }}
  {{- end }}
{{- end }}
